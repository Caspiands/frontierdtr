"[{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01299\",\"v\":\"In plain terms.\"}]},{\"t\":\"#\",\"id\":\"t01300\",\"v\":\" In WordPress, one system stores the content and assembles each page on the server when someone visits, and every plugin and the page builder add their own code to every page. In a headless set-up the content lives in a separate editing system (the \\\"head\\\" that visitors see is removed from it), and the website is a Next.js application that turns that content into finished pages before anyone visits, then serves them from servers close to the patient.\"}]},{\"t\":\"p\",\"k\":[{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01301\",\"v\":\"Speed\"}]},{\"t\":\"#\",\"id\":\"t01302\",\"v\":\" comes from pages being ready in advance and carrying only the code they need. \"},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01303\",\"v\":\"Flexibility\"}]},{\"t\":\"#\",\"id\":\"t01304\",\"v\":\" comes from content being stored once as structured records (a clinic, a doctor, a service) that any site, app or screen can use.\"}]}]},{\"t\":\"div\",\"a\":{\"class\":\"card\",\"style\":\"gap:14px\"},\"k\":[{\"t\":\"h3\",\"k\":[{\"t\":\"#\",\"id\":\"t01305\",\"v\":\"How it fits together\"}]},{\"t\":\"div\",\"a\":{\"class\":\"flow\"},\"k\":[{\"t\":\"div\",\"a\":{\"class\":\"step\"},\"k\":[{\"t\":\"span\",\"a\":{\"class\":\"s\"},\"k\":[{\"t\":\"#\",\"id\":\"t01306\",\"v\":\"1\"}]},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01307\",\"v\":\"Editors\"}]},{\"t\":\"#\",\"id\":\"t01308\",\"v\":\"Frontier, QHS and IMC teams, with a medical reviewer\"}]},{\"t\":\"div\",\"a\":{\"class\":\"step\",\"style\":\"border-top-color:var(--dtr-accent)\"},\"k\":[{\"t\":\"span\",\"a\":{\"class\":\"s\"},\"k\":[{\"t\":\"#\",\"id\":\"t01309\",\"v\":\"2\"}]},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01310\",\"v\":\"Headless CMS\"}]},{\"t\":\"#\",\"id\":\"t01311\",\"v\":\"Clinics, doctors, services, articles and videos, in every language\"}]},{\"t\":\"div\",\"a\":{\"class\":\"step\"},\"k\":[{\"t\":\"span\",\"a\":{\"class\":\"s\"},\"k\":[{\"t\":\"#\",\"id\":\"t01312\",\"v\":\"3\"}]},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01313\",\"v\":\"Next.js\"}]},{\"t\":\"#\",\"id\":\"t01314\",\"v\":\"Shared components, one theme per brand; pages built ahead of time\"}]},{\"t\":\"div\",\"a\":{\"class\":\"step\"},\"k\":[{\"t\":\"span\",\"a\":{\"class\":\"s\"},\"k\":[{\"t\":\"#\",\"id\":\"t01315\",\"v\":\"4\"}]},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01316\",\"v\":\"CDN in Singapore\"}]},{\"t\":\"#\",\"id\":\"t01317\",\"v\":\"Pre-built pages served close to the patient; refreshed when content changes\"}]},{\"t\":\"div\",\"a\":{\"class\":\"step\"},\"k\":[{\"t\":\"span\",\"a\":{\"class\":\"s\"},\"k\":[{\"t\":\"#\",\"id\":\"t01318\",\"v\":\"5\"}]},{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01319\",\"v\":\"Three sites, more channels\"}]},{\"t\":\"#\",\"id\":\"t01320\",\"v\":\"Frontier \u00b7 Qualitas Health SG \u00b7 IMC; later apps, clinic screens, chat\"}]}]},{\"t\":\"p\",\"a\":{\"class\":\"caption\"},\"k\":[{\"t\":\"#\",\"id\":\"t01321\",\"v\":\"Connected, not replaced: booking systems and apps, WhatsApp, the CRM for corporate enquiries, GA4 and Tag Manager, YouTube.\"}]}]},{\"t\":\"div\",\"a\":{\"class\":\"tbl-wrap\"},\"k\":[{\"t\":\"table\",\"k\":[{\"t\":\"thead\",\"k\":[{\"t\":\"tr\",\"k\":[{\"t\":\"th\",\"k\":[{\"t\":\"#\",\"id\":\"t01322\",\"v\":\"Aspect\"}]},{\"t\":\"th\",\"k\":[{\"t\":\"#\",\"id\":\"t01323\",\"v\":\"WordPress with page builders (today)\"}]},{\"t\":\"th\",\"k\":[{\"t\":\"#\",\"id\":\"t01324\",\"v\":\"Headless CMS + Next.js (proposed)\"}]}]}]},{\"t\":\"tbody\",\"k\":[{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"b\",\"k\":[{\"t\":\"#\",\"id\":\"t01325\",\"v\":\"How a page is made\"}]}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01326\",\"v\":\"Assembled from the database and plugins on the server for each visit; caching helps\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01327\",\"v\":\"Built ahead of time as finished pages; refreshed