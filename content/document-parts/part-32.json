"body\",\"k\":[{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01652\",\"v\":\"Content platform\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01653\",\"v\":\"Headless CMS with a visual editor (Storyblok, the CMS CDS runs for its other client websites): roles, medical sign-off before clinical content publishes, scheduled publishing, version history. Editorial region Asia-Pacific where available.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01654\",\"v\":\"Front end\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01655\",\"v\":\"Next.js (TypeScript) with static generation and incremental revalidation: pages are pre-built and refreshed within minutes of an edit. One shared component library; one theme per brand.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01656\",\"v\":\"Hosting\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01657\",\"v\":\"AWS Asia Pacific (Singapore) with CloudFront CDN and web application firewall; preview environment for every change; daily backups kept 30 days. Today's WordPress sites stay online until each go-live.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01658\",\"v\":\"Clinic and doctor data\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01659\",\"v\":\"One structured record per clinic and per doctor (hours, phone, address, languages, services) feeding pages, finders and schema across all three sites, with a monthly export to check against MOH GoWhere and Google profiles.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01660\",\"v\":\"Languages\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01661\",\"v\":\"Field-level translation in the CMS with hreflang: IMC in English, \u4e2d\u6587, \u65e5\u672c\u8a9e, \ud55c\uad6d\uc5b4 and Fran\u00e7ais; Frontier's Healthier SG hub and video pages in \u4e2d\u6587, Melayu and \u0ba4\u0bae\u0bbf\u0bb4\u0bcd.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01662\",\"v\":\"Booking\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01663\",\"v\":\"Frontier web booking and Health Frontier app; IMC Book Online and IMC Health app. Links pass the clinic where the vendor supports it; booking vendors do not change.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01664\",\"v\":\"Measurement\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01665\",\"v\":\"GA4 per site plus a group roll-up, Google Tag Manager, Search Console. Events: booking click by clinic, call, WhatsApp, directions, corporate enquiry. Looker Studio dashboard by clinic and brand.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01666\",\"v\":\"Privacy and consent\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01667\",\"v\":\"Privacy notice and consent banner aligned with Singapore's PDPA; tags respect consent; enquiry data held in Singapore-hosted systems where available.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01668\",\"v\":\"Security\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01669\",\"v\":\"No public admin or database on the live sites; single sign-on with two-factor log-in for the CMS; dependency and vulnerability checks on every release; quarterly scan.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01670\",\"v\":\"Accessibility and speed\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01671\",\"v\":\"WCAG 2.2 AA (24 px tap targets, contrast, alt text). Budget per template: mobile Lighthouse \u2265 90, LCP \u2264 2.5 s, TBT \u2264 200 ms, page weight \u2264 1 MB; checked automatically on every release.\"}]}]},{\"t\":\"tr\",\"k\":[{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01672\",\"v\":\"Integrations\"}]},{\"t\":\"td\",\"k\":[{\"t\":\"#\",\"id\":\"t01673\",\"v\":\"Corporate enquiry form to the CRM (Frontier Healthcare's existing CRM, or HubSpot if none); YouTube for video; WhatsApp click-to-chat per clinic; CMS webhooks to rebuild changed p