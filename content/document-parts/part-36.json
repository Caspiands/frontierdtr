":{\"class\":\"card\"},\"k\":[{\"t\":\"h3\",\"k\":[{\"t\":\"#\",\"id\":\"t01857\",\"v\":\"Per clinic, at set-up\"}]},{\"t\":\"ul\",\"k\":[{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01858\",\"v\":\"MOH GoWhere: name with location (e.g. \\\"Frontier Medical Associates (Woodlands Dr 73)\\\"), hours, phone, submitted by Frontier through MOH's process\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01859\":\"v\":\"Google Business Profile: primary category, hours incl. public holidays, photos of the entrance and waiting area, services list incl. Healthier SG and CHAS, booking link to this clinic\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01860\",\"v\":\"Apple Maps and key directories aligned\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01861\",\"v\":\"Clinic page schema identical to the above\"}]}]}]},{\"t\":\"div\",\"a\":{\"class\":\"card\"},\"k\":[{\"t\":\"h3\",\"k\":[{\"t\":\"#\",\"id\":\"t01862\",\"v\":\"Every month\"}]},{\"t\":\"ul\",\"k\":[{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01863\",\"v\":\"Data check: website vs MOH vs Google for all clinics, with a change log\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01864\",\"v\":\"Google posts for seasonal services (flu season, travel, school holidays)\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01865\",\"v\":\"Respond to new reviews within two business days, factually and without patient details\"}]},{\"t\":\"li\",\"k\":[{\"t\":\"#\",\"id\":\"t01866\",\"v\":\"Local rank grid per clinic for \\\"GP clinic [area]\\\" and priority services\"}]}]}]}]},{\"t\":\"div\",\"a\":{\"class\":\"card\",\"style\":\"border-left:3px solid var(--dtr-accent)\"},\"k\":[{\"t\":\"h3\",\"k\":[{\"t\":\"#\",\"id\":\"t01867\",\"v\":\"Reviews and the advertising rules\"}]},{\"t\":\"p\",\"k\":[{\"t\":\"#\",\"id\":\"t01868\",\"v\":\"Under the Healthcare Services (Advertisement) Regulations, clinics may not reproduce testimonials on their own website or social media, and SMC guidance says doctors must not ask or induce patients